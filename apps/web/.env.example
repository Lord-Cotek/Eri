# ── Site ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Database ───────────────────────────────────────────────────────────
# Neon Postgres. Use the POOLED connection string for the app runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Auth ───────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="run: openssl rand -base64 32"

# ── Mail ───────────────────────────────────────────────────────────────
# Sign-in is a magic link, so one transport is required in production.
#
# Prefer Resend: it is one HTTPS request, which suits a serverless function
# better than holding an SMTP socket open across a cold start.
RESEND_API_KEY=""
# ...or SMTP, if you are not using Resend. Set one, not both.
EMAIL_SERVER=""
# The address mail is sent from. Its domain must be verified with your
# provider, or the links land in spam — or are rejected outright.
EMAIL_FROM="no-reply@cotek.app"
#
# With neither set, in development only, sign-in links and notifications are
# printed to the server console. The in-app inbox is written either way.

# ── Ẹlẹ́rìí ─────────────────────────────────────────────────────────────
# Without a key, Ẹlẹ́rìí falls back to plain non-generated copy rather than
# failing — the covenant works whether or not the AI layer is reachable.
ANTHROPIC_API_KEY=""
# Sonnet drafts; Haiku handles routine generation. Overridable per call.
ANTHROPIC_MODEL_DRAFTING="claude-sonnet-5"
ANTHROPIC_MODEL_ROUTINE="claude-haiku-4-5-20251001"

# ── Cron ───────────────────────────────────────────────────────────────
# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`.
# Without it the sweep endpoint is closed, windows never lapse, and silence is
# never reported. Required in production.
CRON_SECRET="run: openssl rand -hex 32"

# ── Crisis resources ───────────────────────────────────────────────────
# REQUIRED, in every environment. There is no default and the app refuses to
# start without them — in development, at build, and at runtime.
#
# Surfaced verbatim when Ẹlẹ́rìí stops the flow. Set them for the region you
# actually serve. A wrong number here is worse than no product: it tells a man
# in trouble to call someone who cannot help him, and nothing looks broken.
#
# TWO numbers, deliberately. Most national support lines keep office hours —
# the UAE's is 8am to 8pm — and this product's whole subject is what happens
# at one in the morning. A daytime-only number shown at 01:14 is a quiet way
# of offering nothing, so an always-answering number is required too.
#
# United Arab Emirates:
CRISIS_LINE_NAME="Mental Support Line"
CRISIS_LINE_CONTACT="800 HOPE (800 4673), Arabic and English"
CRISIS_LINE_HOURS="8am to 8pm"
CRISIS_EMERGENCY_CONTACT="999 (police) or 998 (ambulance)"
#
# United Kingdom, for reference:
# CRISIS_LINE_NAME="Samaritans"
# CRISIS_LINE_CONTACT="116 123, free"
# CRISIS_LINE_HOURS=""
# CRISIS_EMERGENCY_CONTACT="999"
