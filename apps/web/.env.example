# ── Site ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Database ───────────────────────────────────────────────────────────
# Neon Postgres. Use the POOLED connection string for the app runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Auth ───────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="run: openssl rand -base64 32"

# Email magic-link sign-in, and the channel notifications go out on.
# Leave EMAIL_SERVER empty in development: notifications are still written to
# the in-app inbox, and the would-be email is logged to the server console.
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="no-reply@cotek.live"

# ── Ẹlẹ́rìí ─────────────────────────────────────────────────────────────
# Without a key, Ẹlẹ́rìí falls back to plain non-generated copy rather than
# failing — the covenant works whether or not the AI layer is reachable.
ANTHROPIC_API_KEY=""
# Sonnet drafts; Haiku handles routine generation. Overridable per call.
ANTHROPIC_MODEL_DRAFTING="claude-sonnet-5"
ANTHROPIC_MODEL_ROUTINE="claude-haiku-4-5-20251001"

# ── Cron ───────────────────────────────────────────────────────────────
# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET="run: openssl rand -hex 32"

# ── Crisis resources ───────────────────────────────────────────────────
# Surfaced verbatim when Ẹlẹ́rìí stops the flow. Set these for your region.
CRISIS_LINE_NAME="Samaritans"
CRISIS_LINE_CONTACT="116 123 (UK, 24 hours)"
